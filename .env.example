GEMINI_MODEL=gemini-3.5-flash
GEMINI_LOCATION=global
# local: run GuardianAgent here; vertex: call a deployed Agent Engine using server ADC.
ANALYSIS_BACKEND=local
VERTEX_AGENT_RESOURCE=
# In vertex mode Gemini and GitHub read credentials live in the cloud runtime.
# Only set a local GITHUB_TOKEN if you also need the separate approved Issue-write flow.
# Choose Gemini API key OR Vertex AI Application Default Credentials.
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GITHUB_TOKEN=
ALLOW_GITHUB_WRITES=false
DATABASE_PATH=data/campuspulse.sqlite3
ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
